###########################################################################
#                    uConsole-Sleep configuration file                    #
###########################################################################

### HOLD_TRIGGER_SEC --- [0.0~] --- Time(sec) to trigger power interactive
# default 0.7
#HOLD_TRIGGER_SEC=1.3

### POWERKEY_DPMS_OFF_CMD --- shell command --- Ask the compositor to DPMS off on power-key sleep
###  - Run as the logged-in graphical user (environment taken from the running
###    session) before the backlight/DRM writes. Without it a Wayland compositor
###    keeps scanning out to the dark panel: on a CM5 uConsole under Hyprland
###    that is ~0.7 W more than the compositor's own DPMS-off path.
###  - Examples (uncomment one):
###      Hyprland: hyprctl dispatch dpms off
###      sway:     swaymsg "output * power off"
###      X11:      xset dpms force off
# default empty (sysfs writes only, as before)
#POWERKEY_DPMS_OFF_CMD=hyprctl dispatch dpms off

### POWERKEY_DPMS_ON_CMD --- shell command --- Mirror of POWERKEY_DPMS_OFF_CMD for wake
###      Hyprland: hyprctl dispatch dpms on
###      sway:     swaymsg "output * power on"
###      X11:      xset dpms force on
# default empty
#POWERKEY_DPMS_ON_CMD=hyprctl dispatch dpms on

### POWERKEY_DPMS_SETTLE_SEC --- [0.0~] --- Pause after a DPMS command before the sysfs writes
# default 0.3
#POWERKEY_DPMS_SETTLE_SEC=0.5

### SAVING_CPU_FREQ --- [100,100~] <min,max> --- Freq(MHz) for power saving
# default 100,100 (depends on cpuinfo)
#SAVING_CPU_FREQ=300,600

### DISABLE_POWER_OFF_DRM --- [yes/no] --- Disable turn off DRM on sleep
###  - If you have some issue with recover screen, you can set this "yes"
# default no
#DISABLE_POWER_OFF_DRM=yes

### DISABLE_POWER_OFF_KB --- [yes/no] --- Disable turn off Keyboard on sleep
###  - If you set this to "yes", the keyboard can turn on/off the light.
# default no
#DISABLE_POWER_OFF_KB=yes

### KB_SLEEP_LED --- [none/numlock/capslock/scrolllock/compose/kana] --- Keyboard sleep signal
###  - Before the keyboard is detached on sleep, this LED bit is set in its HID LED
###    output report; it is cleared again after the keyboard is re-attached on wake.
###    Firmware that understands it (uConsole-tweaks/zmk-uc9900 on the bb9900)
###    darkens its key backlight and trackpad light and drops to low power while
###    the bit is set. Other firmware ignores it. "none" disables the signal.
# default kana
#KB_SLEEP_LED=none

### KB_SLEEP_LED_WAIT_SEC --- [0.0~] --- How long to wait for the keyboard's hidraw
###    node to reappear after re-attach before clearing the sleep LED
# default 2
#KB_SLEEP_LED_WAIT_SEC=5

### KB_SLEEP_USB_SUSPEND --- [yes/no] --- USB-suspend the detached keyboard on sleep
###  - After the driver is unbound the USB link is put into selective suspend so
###    the keyboard MCU can park its USB clock. Resumed before re-attach on wake.
###    EXPERIMENTAL: on the uConsole's internal hub (Genesys 05e3:0608 behind
###    dwc2) runtime PM of the bb9900 ends in runtime_status=error, the rebind
###    fails ("can't set config #1, error -22") and the keyboard stays dead until
###    a reboot; re-probing the hub wedges both full-speed ports (error -71).
###    Leave off unless you are testing it.
###    Ignored when DISABLE_POWER_OFF_KB=yes (that path already autosuspends).
# default no
#KB_SLEEP_USB_SUSPEND=yes

### KB_SLEEP_DELAY_SEC --- [0.0~] --- Grace period before the keyboard is put to sleep
###  - The keyboard sleep (LED, detach, USB suspend) is deferred this long after
###    the screen goes off; if the screen comes back first, the sleep is cancelled.
###    Keeps the keyboard awake across sleep-idle-alert's backlight flash instead
###    of detaching and re-attaching it on every pulse. Wake is always immediate.
# default 1.0
#KB_SLEEP_DELAY_SEC=0

### The three SLEEP_* knobs below apply only on battery, like the cpu freq
### clamp: plugged in means full performance. Plugging in while asleep lifts
### them at the next AC poll (POLL_AC_INTERVAL_SEC); unplugging applies them.

### SLEEP_WIFI_POWERSAVE --- [yes/no] --- 802.11 power save while asleep
###  - Applied with the deferred keyboard sleep (KB_SLEEP_DELAY_SEC) on every
###    wireless interface via `iw`, restored to its previous state on wake.
###    The link stays up (SSH keeps working); first-packet latency goes up.
###    On the uConsole CM5 the brcmfmac driver already has power save on, so
###    this is a no-op there (the log says "already on").
# default no
#SLEEP_WIFI_POWERSAVE=yes

### SLEEP_BT_OFF --- [yes/no] --- rfkill-block Bluetooth while asleep
###  - Only when no device is connected at sleep time; unblocked at wake only
###    if this service blocked it. Uses the kernel rfkill switch rather than
###    bluetoothctl so desktop applets (blueman) see a consistent state and
###    do not raise a polkit prompt.
# default no
#SLEEP_BT_OFF=yes

### SLEEP_CPU_QUOTA --- [1~] --- Cap user processes to this % of one CPU while asleep
###  - Sets a runtime systemd CPUQuota on every user-<uid>.slice at sleep and
###    clears it on wake. Nothing is stopped or signalled; the aggregate CPU
###    time of your sessions is capped, so a build or download you left
###    running finishes slower. 100 = one full core, 400 = no effective cap.
# default empty (no cap)
#SLEEP_CPU_QUOTA=50

### DISABLE_CPU_MIN_FREQ --- [yes/no] --- Disable set cpu freq max to min
# default no
#DISABLE_CPU_MIN_FREQ=yes

### POLL_AC_INTERVAL_SEC --- [1~] --- AC poll interval (seconds) while screen is off
###  - When AC plugged, cpu freq clamp is skipped. This poll picks up plug/unplug
###    while the screen is off so behavior catches up without waking the screen.
# default 30
#POLL_AC_INTERVAL_SEC=60

### CPU_GOVERNOR_NORMAL --- governor name --- Used on AC or above hysteresis
# default schedutil
#CPU_GOVERNOR_NORMAL=ondemand

### CPU_GOVERNOR_LOW_BATTERY --- governor name --- Used below low-battery threshold
# default powersave
#CPU_GOVERNOR_LOW_BATTERY=conservative

### CPU_LOW_BATTERY_ENTER_PCT --- [0-100] --- Drop to low-battery governor below this %
# default 20
#CPU_LOW_BATTERY_ENTER_PCT=15

### CPU_LOW_BATTERY_EXIT_PCT --- [0-100] --- Restore normal governor at or above this %
# default 25 (must be >= ENTER to provide hysteresis)
#CPU_LOW_BATTERY_EXIT_PCT=30

### CPU_GOVERNOR_POLL_SEC --- [1~] --- Battery/AC poll interval in seconds
# default 30
#CPU_GOVERNOR_POLL_SEC=60

###########################################################################
# sleep-idle-alert (user service)
###########################################################################

### IDLE_INITIAL_DELAY --- [1~] --- Seconds of idle-on-battery before "gentle" tier
# default 900
#IDLE_INITIAL_DELAY=600

### IDLE_INTERVAL --- [1~] --- Seconds between gentle and nag squawks
# default 600
#IDLE_INTERVAL=300

### IDLE_INTERVAL_DUMBASS --- [1~] --- Seconds between dumbass squawks (third tier and beyond)
# default 120
#IDLE_INTERVAL_DUMBASS=60

### IDLE_TICK --- [1~] --- Poll resolution + idle threshold for the X11 / swayidle backend
# default 30
#IDLE_TICK=15

### IDLE_SOUND_DIR --- path --- Where the alerter looks for tier .ogg files
###  - Empty string means "$HOME/Music/notifications" (resolved at service start)
###  - Resolution order per squawk:
###      1. IDLE_SOUNDS_<TIER> curated filename list (relative to IDLE_SOUND_DIR)
###      2. IDLE_SOUND_DIR/<tier>/ subdirectory
###      3. IDLE_SOUND_DIR (flat)
###      4. /usr/share/sounds/freedesktop/stereo/ (sound-theme-freedesktop)
# default empty
#IDLE_SOUND_DIR=/home/pi/Music/notifications

### IDLE_SOUNDS_<TIER> --- pipe-separated filenames --- Curated per-tier pools
###  - Filenames resolve relative to IDLE_SOUND_DIR.
###  - Missing files are silently skipped (the layer falls through if none exist).
###  - The values below mirror the curated lists shipped with the
###    pre-v1.6 IdleAlert.sh wrapper for this device.
IDLE_SOUNDS_WARN=Excuse Me Sir.ogg|Psst.ogg|Kim Possible Beep.ogg
IDLE_SOUNDS_GENTLE=Bleep.ogg|Sifi notification blip.ogg|Galaga.ogg|mainframe04.ogg
IDLE_SOUNDS_NAG=Grr Argh.ogg|Mouthbreather.ogg|Dethbleep.ogg|Psycho short.ogg
IDLE_SOUNDS_DUMBASS=Spam 1.ogg|Angerfist.ogg|Predator.ogg|Haunted Mansion Laugh.ogg

### IDLE_LOCK_PROCESSES --- space-separated process names --- Optional lock gating
###  - When non-empty, squawks fire only while one of these processes is running.
###  - Empty (default) means idle-time only -- no lock requirement.
# default empty
#IDLE_LOCK_PROCESSES=hyprlock swaylock xscreensaver light-locker i3lock

### IDLE_FLASH_ENABLED --- [true/false] --- Pulse the backlight alongside each squawk
# default true
#IDLE_FLASH_ENABLED=false

### IDLE_FLASH_INITIAL_ON_SEC --- [0.0~] --- Initial long ON-hold (seconds) before pulses
# default 5.0
#IDLE_FLASH_INITIAL_ON_SEC=3.0

### IDLE_FLASH_PULSES --- [0~] --- Number of follow-up ON pulses after the initial hold
# default 5
#IDLE_FLASH_PULSES=3

### IDLE_FLASH_PULSE_START_SEC --- [0.0~] --- ON duration of the first pulse (seconds)
# default 2.0
#IDLE_FLASH_PULSE_START_SEC=1.5

### IDLE_FLASH_PULSE_DECAY --- [0.0-1.0] --- Geometric decay applied to each pulse's ON time
# default 0.25
#IDLE_FLASH_PULSE_DECAY=0.5

### IDLE_FLASH_PULSE_OFF_SEC --- [0.0~] --- Fixed OFF gap between pulses (seconds)
# default 0.25
#IDLE_FLASH_PULSE_OFF_SEC=0.5

### IDLE_FLASH_PULSE_MIN_SEC --- [0.0~] --- Floor for the decaying ON duration
# default 0.1
#IDLE_FLASH_PULSE_MIN_SEC=0.05

### IDLE_DPMS_WAKE_CMD --- shell command --- Wake the display before each flash
###  - Required if the compositor turns the panel off via DPMS before the
###    first squawk fires; bl_power pulses are invisible to a DPMS-off panel.
###  - Examples (uncomment one):
###      Hyprland: hyprctl dispatch dpms on
###      sway:     swaymsg "output * power on"
###      X11:      xset dpms force on
# default empty (no DPMS interaction)
#IDLE_DPMS_WAKE_CMD=hyprctl dispatch dpms on

### IDLE_DPMS_SLEEP_CMD --- shell command --- Put the display back to sleep after each flash
###  - Mirror of IDLE_DPMS_WAKE_CMD. Leave empty to keep the screen on once
###    the flash ends.
###  - Examples (uncomment one):
###      Hyprland: hyprctl dispatch dpms off
###      sway:     swaymsg "output * power off"
###      X11:      xset dpms force off
# default empty
#IDLE_DPMS_SLEEP_CMD=hyprctl dispatch dpms off

### IDLE_DPMS_WAKE_SETTLE_SEC --- [0.0~] --- Settle delay between wake and the first pulse
###  - Lets the panel come up before bl_power writes start. The 5s INITIAL
###    ON hold absorbs most panels; bump if your panel wakes slowly.
# default 0.1
#IDLE_DPMS_WAKE_SETTLE_SEC=0.3
